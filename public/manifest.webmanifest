{
  "id": "./",
  "name": "Carolina tracker",
  "short_name": "Carolina",
  "description": "Feedings, diapers and mom's medication, shared between caregivers.",
  "lang": "en-US",
  "dir": "ltr",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#ffffff",
  "theme_color": "#ffffff",
  "categories": ["health", "lifestyle", "medical"],
  "launch_handler": { "client_mode": ["focus-existing", "auto"] },
  "icons": [
    { "src": "icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" },
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icon-maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "badge-96.png", "sizes": "96x96", "type": "image/png", "purpose": "monochrome" }
  ],
  "shortcuts": [
    {
      "name": "Log a feeding",
      "short_name": "Feeding",
      "url": "./?log=feeding",
      "icons": [{ "src": "shortcut-feeding.png", "sizes": "96x96", "type": "image/png" }]
    },
    {
      "name": "Log a diaper",
      "short_name": "Diaper",
      "url": "./?log=diaper",
      "icons": [{ "src": "shortcut-diaper.png", "sizes": "96x96", "type": "image/png" }]
    },
    {
      "name": "Log medicine",
      "short_name": "Medicine",
      "url": "./?log=med",
      "icons": [{ "src": "shortcut-med.png", "sizes": "96x96", "type": "image/png" }]
    },
    {
      "name": "Appointments",
      "short_name": "Calendar",
      "url": "./?tab=calendar",
      "icons": [{ "src": "shortcut-calendar.png", "sizes": "96x96", "type": "image/png" }]
    }
  ],
  "screenshots": [
    {
      "src": "screenshot-now.png",
      "sizes": "1080x2340",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "What's due now: the next feed, diaper check and medicine"
    },
    {
      "src": "screenshot-reports.png",
      "sizes": "1080x2340",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Reports on feeds, diapers and temperature"
    }
  ]
}
